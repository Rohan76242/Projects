# ==============================================================================
#                       Z3RO / SOBIA CONFIGURATION (.env)
# ==============================================================================

# Assistant Identity & Mode
ASSISTANT_NAME=Z3RO
DEFAULT_MODE=voice                  # voice | type | ptt | cloud
ENGINE=local                        # local (Ollama) | cloud (Gemini) | hybrid

# Local Ollama AI Settings
OLLAMA_HOST=http://127.0.0.1:11434
BRAIN_MODEL=qwen2.5:1.5b-instruct
VISION_MODEL=moondream:latest
NUM_PREDICT=700
NUM_CTX=2048

# Cloud AI (Google Gemini - Required only for SOBIA Cloud / Gemini Live)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Audio & Wake-Word
AUDIO_SAMPLE_RATE=16000
# MIC_DEVICE_INDEX=1                # Optional: specify input device index
WAKEWORD_THRESHOLD=0.50

# Speech to Text (Whisper)
STT_MODEL_SIZE=base.en              # tiny.en | base.en | small.en
STT_DEVICE=cpu                      # cpu | cuda
STT_COMPUTE_TYPE=int8               # int8 | float16 | float32

# Text to Speech (Offline pyttsx3)
TTS_RATE=180
TTS_VOLUME=0.9
TTS_VOICE_INDEX=0

# Automation & Safety
MAX_AGENT_STEPS=6
ACTION_DELAY=0.5
ENABLE_VISION_VERIFICATION=true

# Logging
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
